<?xml version="1.0" encoding="utf-8"?>
<!-- Mobile version of admin/inventory.html -->
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/swipe" android:layout_width="match_parent" android:layout_height="match_parent">
<ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:padding="12dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="24dp">

<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Track rental equipment, availability and condition." android:textColor="@color/muted" android:textSize="13sp"/>

<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center_vertical" android:orientation="horizontal">
<ImageButton android:id="@+id/invRefresh" android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bg_icon_button" android:contentDescription="Refresh inventory" android:src="@drawable/ic_refresh" app:tint="@color/muted"/>
<com.google.android.material.button.MaterialButton android:id="@+id/invAdd" style="@style/PrimaryButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_marginEnd="8dp" android:text="+  Add Rental Item"/>
<ImageButton android:id="@+id/invBell" android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bg_icon_button" android:contentDescription="Notifications" android:src="@drawable/ic_bell" app:tint="@color/muted"/>
</LinearLayout>

<View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="14dp" android:background="@color/border"/>

<LinearLayout style="@style/Panel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:orientation="vertical">
<TextView android:id="@+id/syncSummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="32dp" android:gravity="center_vertical" android:text="▸  Online · 0 Pending Sync" android:textColor="@color/text" android:textSize="15sp"/>
<TextView android:id="@+id/syncDetail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Everything is saved. Changes made while offline will appear here until they are synced." android:textColor="@color/muted" android:textSize="12sp" android:visibility="gone"/>
</LinearLayout>

<GridLayout android:id="@+id/invStats" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:columnCount="2"/>

<LinearLayout style="@style/Panel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="vertical">
<TextView style="@style/PanelTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="All Rental Items"/>
<com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp" android:hint="Search item or code...">
<com.google.android.material.textfield.TextInputEditText android:id="@+id/invSearch" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text" android:maxLines="1" android:textSize="14sp"/>
</com.google.android.material.textfield.TextInputLayout>
<HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="horizontal">
<LinearLayout android:id="@+id/invTable" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical"/>
</HorizontalScrollView>
</LinearLayout>

<LinearLayout style="@style/Panel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="vertical">
<TextView style="@style/PanelTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Items Requiring Attention"/>
<HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="horizontal">
<LinearLayout android:id="@+id/invAttention" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical"/>
</HorizontalScrollView>
</LinearLayout>

</LinearLayout>
</ScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
