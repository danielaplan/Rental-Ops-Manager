<?xml version="1.0" encoding="utf-8"?>
<!-- Dashboard stat card (.stat-card.compact-stat-card.dashboard-stat-card): accent bar, label + icon, serif value -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_margin="5dp"
    android:layout_columnWeight="1"
    android:background="@drawable/bg_panel"
    android:orientation="horizontal">

    <View
        android:id="@+id/statBar"
        android:layout_width="3dp"
        android:layout_height="match_parent"
        android:layout_marginTop="1dp"
        android:layout_marginBottom="1dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/statLabel"
                style="@style/SectionLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="11sp" />

            <FrameLayout
                android:id="@+id/statIconBox"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="6dp">

                <ImageView
                    android:id="@+id/statIcon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null" />
            </FrameLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/statValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="serif"
            android:textColor="@color/primary_dark"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
