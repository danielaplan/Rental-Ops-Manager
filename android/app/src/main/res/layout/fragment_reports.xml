<?xml version="1.0" encoding="utf-8"?>
<!-- Mobile version of admin/reports.html: date range, live charts, stat cards, operational totals, package popularity, damaged/missing items -->
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/repSwipe" android:layout_width="match_parent" android:layout_height="match_parent">
<ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:padding="12dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="24dp">

<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
<TextView android:id="@+id/repLive" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_badge_outline" android:minHeight="44dp" android:gravity="center_vertical" android:paddingStart="12dp" android:paddingEnd="12dp" android:text="● Live" android:textColor="@color/primary" android:textSize="12sp" android:textStyle="bold"/>
<View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
<ImageButton android:id="@+id/repBell" android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bg_icon_button" android:contentDescription="Notifications" android:src="@drawable/ic_bell" app:tint="@color/muted"/>
</LinearLayout>
<View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="14dp" android:background="@color/border"/>

<LinearLayout style="@style/Panel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:orientation="vertical">
<TextView android:id="@+id/repSyncSummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="32dp" android:gravity="center_vertical" android:text="▸  Online · 0 Pending Sync" android:textColor="@color/text" android:textSize="15sp"/>
<TextView android:id="@+id/repSyncDetail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Everything is saved. Changes made while offline will appear here until they are synced." android:textColor="@color/muted" android:textSize="12sp" android:visibility="gone"/>
</LinearLayout>

<LinearLayout style="@style/Panel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="vertical">
<TextView style="@style/PanelTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="4dp" android:text="Report Date Range"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Booking activity uses event dates. Collected revenue uses completed-payment dates." android:textColor="@color/muted" android:textSize="13sp"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center_vertical" android:orientation="horizontal">
<TextView android:id="@+id/repRangeBadge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_badge_outline" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:text="All booking dates" android:textColor="@color/text" android:textSize="12sp" android:textStyle="bold"/>
<com.google.android.material.button.MaterialButton android:id="@+id/repReceipt" style="@style/OutlineButton" android:layout_width="wrap_content" android:layout_height="40dp" android:layout_marginStart="8dp" android:minHeight="0dp" android:paddingStart="12dp" android:paddingEnd="12dp" android:text="View Receipt" android:textSize="12sp" app:icon="@drawable/ic_doc" app:iconSize="16dp"/>
</LinearLayout>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="From" android:textColor="@color/text" android:textSize="14sp" android:textStyle="bold"/>
<com.google.android.material.button.MaterialButton android:id="@+id/repStart" style="@style/OutlineButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="start|center_vertical" android:text="mm/dd/yyyy" android:textColor="@color/text" app:icon="@drawable/ic_calendar" app:iconGravity="end" app:iconTint="@color/muted"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="To" android:textColor="@color/text" android:textSize="14sp" android:textStyle="bold"/>
<com.google.android.material.button.MaterialButton android:id="@+id/repEnd" style="@style/OutlineButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="start|center_vertical" android:text="mm/dd/yyyy" android:textColor="@color/text" app:icon="@drawable/ic_calendar" app:iconGravity="end" app:iconTint="@color/muted"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal">
<com.google.android.material.button.MaterialButton android:id="@+id/repRun" style="@style/PrimaryButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Apply" app:icon="@drawable/ic_filter"/>
<ImageButton android:id="@+id/repReset" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginStart="8dp" android:background="@drawable/bg_icon_button" android:contentDescription="Reset date range" android:src="@drawable/ic_refresh" app:tint="@color/muted"/>
</LinearLayout>
</LinearLayout>

<TextView android:id="@+id/repState" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Showing saved data while the latest data is checked." android:textColor="@color/muted" android:textSize="13sp"/>
<com.google.android.material.button.MaterialButton android:id="@+id/repRefresh" style="@style/OutlineButton" android:layout_width="wrap_content" android:layout_height="40dp" android:layout_marginTop="6dp" android:minHeight="0dp" android:paddingStart="12dp" android:paddingEnd="12dp" android:text="Refresh data" android:textSize="12sp" app:icon="@drawable/ic_refresh" app:iconSize="16dp"/>

<LinearLayout style="@style/Panel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:orientation="vertical">
<TextView style="@style/PanelTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:drawableStart="@drawable/ic_pie" android:drawablePadding="8dp" android:drawableTint="@color/badge_success" android:gravity="center_vertical" android:text="Bookings by Status"/>
<com.akad.rentalops.ui.charts.DonutChartView android:id="@+id/repStatusChart" android:layout_width="match_parent" android:layout_height="270dp"/>
</LinearLayout>

<LinearLayout style="@style/Panel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="vertical">
<TextView style="@style/PanelTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:drawableStart="@drawable/ic_chart" android:drawablePadding="8dp" android:drawableTint="@color/badge_info" android:gravity="center_vertical" android:text="Most Popular Services"/>
<com.akad.rentalops.ui.charts.BarChartView android:id="@+id/repServicesChart" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:id="@+id/repServicesEmpty" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:padding="12dp" android:text="No service bookings in this period." android:textColor="@color/muted" android:textSize="13sp" android:visibility="gone"/>
</LinearLayout>

<GridLayout android:id="@+id/repStats" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:columnCount="2"/>

<LinearLayout style="@style/Panel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="vertical">
<TextView style="@style/PanelTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="4dp" android:text="Operational totals"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Revenue and popularity follow the selected period. Balances, deposits, completed bookings, cancellations, and approved overlaps are lifetime totals." android:textColor="@color/muted" android:textSize="13sp"/>
<GridLayout android:id="@+id/repOps" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:columnCount="2"/>
</LinearLayout>

<LinearLayout style="@style/Panel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="vertical">
<TextView style="@style/PanelTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Package Popularity"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@color/bg" android:gravity="center_vertical" android:orientation="horizontal">
<TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:paddingStart="4dp" android:paddingEnd="4dp" android:paddingTop="12dp" android:paddingBottom="12dp" android:text="PACKAGE" android:textColor="@color/muted" android:textSize="9sp" android:textStyle="bold"/>
<TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:paddingStart="4dp" android:paddingEnd="4dp" android:paddingTop="12dp" android:paddingBottom="12dp" android:text="SERVICE" android:textColor="@color/muted" android:textSize="9sp" android:textStyle="bold"/>
<TextView android:layout_width="58dp" android:gravity="center" android:layout_height="wrap_content" android:paddingStart="4dp" android:paddingEnd="4dp" android:paddingTop="12dp" android:paddingBottom="12dp" android:text="BOOKINGS" android:textColor="@color/muted" android:textSize="9sp" android:textStyle="bold"/>
<TextView android:layout_width="58dp" android:gravity="center" android:layout_height="wrap_content" android:paddingStart="4dp" android:paddingEnd="4dp" android:paddingTop="12dp" android:paddingBottom="12dp" android:text="COMPLETED" android:textColor="@color/muted" android:textSize="9sp" android:textStyle="bold"/>
<TextView android:layout_width="58dp" android:gravity="center" android:layout_height="wrap_content" android:paddingStart="4dp" android:paddingEnd="4dp" android:paddingTop="12dp" android:paddingBottom="12dp" android:text="CANCELLED" android:textColor="@color/muted" android:textSize="9sp" android:textStyle="bold"/>
</LinearLayout>
<View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/border"/>
<LinearLayout android:id="@+id/repPackages" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
<TextView android:id="@+id/repPackagesEmpty" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:padding="16dp" android:text="No package bookings in this period." android:textColor="@color/muted" android:textSize="14sp" android:visibility="gone"/>
</LinearLayout>

<LinearLayout style="@style/Panel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="vertical">
<TextView style="@style/PanelTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Damaged / Missing Rental Items"/>
<HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="horizontal">
<LinearLayout android:id="@+id/repDamaged" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical"/>
</HorizontalScrollView>
<TextView android:id="@+id/repDamagedEmpty" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:padding="16dp" android:text="No damaged or missing items." android:textColor="@color/muted" android:textSize="14sp" android:visibility="gone"/>
</LinearLayout>

</LinearLayout>
</ScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
