<?xml version="1.0" encoding="utf-8"?>
<!-- Mobile version of admin/dashboard.html -->
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/swipe" android:layout_width="match_parent" android:layout_height="match_parent">
<ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:padding="12dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="24dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="A quick view of current operations and upcoming work." android:textColor="@color/muted" android:textSize="13sp"/>
<TextView android:id="@+id/dashboardDataState" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Showing saved data while the latest data is checked." android:textColor="@color/muted" android:textSize="13sp"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center_vertical" android:orientation="horizontal">
<ImageButton android:id="@+id/refreshDashboardData" android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bg_icon_button" android:contentDescription="Refresh dashboard data" android:src="@drawable/ic_refresh" app:tint="@color/muted"/>
<com.google.android.material.button.MaterialButton android:id="@+id/dashNewBooking" style="@style/AccentButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_marginEnd="8dp" android:text="+  Create Manual Booking"/>
<ImageButton android:id="@+id/dashBell" android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bg_icon_button" android:contentDescription="Notifications" android:src="@drawable/ic_bell" app:tint="@color/muted"/>
</LinearLayout>
<View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="14dp" android:background="@color/border"/>
<LinearLayout android:id="@+id/syncPanel" style="@style/Panel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:orientation="vertical">
<TextView android:id="@+id/syncSummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="32dp" android:gravity="center_vertical" android:text="▸  Online · 0 Pending Sync" android:textColor="@color/text" android:textSize="15sp"/>
<TextView android:id="@+id/syncDetail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Everything is saved. Changes made while offline will appear here until they are synced." android:textColor="@color/muted" android:textSize="12sp" android:visibility="gone"/>
</LinearLayout>
<LinearLayout style="@style/Panel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:orientation="vertical">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:gravity="center_vertical" android:orientation="horizontal">
<LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
<TextView style="@style/PanelTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="0dp" android:drawableStart="@drawable/ic_trend" android:drawablePadding="8dp" android:drawableTint="@color/primary" android:gravity="center_vertical" android:text="Revenue &amp; Bookings Trend"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Monthly performance overview" android:textColor="@color/muted" android:textSize="13sp"/>
</LinearLayout>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_badge_outline" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:text="Recent Months" android:textColor="@color/text" android:textSize="12sp" android:textStyle="bold"/>
</LinearLayout>
<com.akad.rentalops.ui.charts.LineChartView android:id="@+id/revenueChart" android:layout_width="match_parent" android:layout_height="280dp"/>
</LinearLayout>
<LinearLayout style="@style/Panel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="vertical">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:gravity="center_vertical" android:orientation="horizontal">
<TextView style="@style/PanelTitle" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginBottom="0dp" android:drawableStart="@drawable/ic_pie" android:drawablePadding="8dp" android:drawableTint="@color/badge_success" android:gravity="center_vertical" android:text="Booking Status"/>
</LinearLayout>
<com.akad.rentalops.ui.charts.DonutChartView android:id="@+id/statusChart" android:layout_width="match_parent" android:layout_height="270dp"/>
</LinearLayout>
<GridLayout android:id="@+id/statsRow" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:columnCount="2"/>
<LinearLayout style="@style/Panel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="vertical">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:gravity="center_vertical" android:orientation="horizontal">
<TextView style="@style/PanelTitle" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginBottom="0dp" android:drawableStart="@drawable/ic_chart" android:drawablePadding="8dp" android:drawableTint="@color/badge_info" android:gravity="center_vertical" android:text="Most Booked Services"/>
<com.google.android.material.button.MaterialButton android:id="@+id/dashManageServices" style="@style/OutlineButton" android:layout_width="wrap_content" android:layout_height="40dp" android:layout_marginStart="8dp" android:minHeight="0dp" android:paddingStart="12dp" android:paddingEnd="12dp" android:text="Manage Services" android:textSize="12sp"/>
</LinearLayout>
<com.akad.rentalops.ui.charts.BarChartView android:id="@+id/servicesChart" android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout>
<LinearLayout style="@style/Panel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="vertical">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:gravity="center_vertical" android:orientation="horizontal">
<TextView style="@style/PanelTitle" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginBottom="0dp" android:drawableStart="@drawable/ic_warning" android:drawablePadding="8dp" android:drawableTint="@color/badge_warning" android:gravity="center_vertical" android:text="Inventory Attention"/>
<com.google.android.material.button.MaterialButton android:id="@+id/dashViewInventory" style="@style/OutlineButton" android:layout_width="wrap_content" android:layout_height="40dp" android:layout_marginStart="8dp" android:minHeight="0dp" android:paddingStart="12dp" android:paddingEnd="12dp" android:text="View Inventory" android:textSize="12sp"/>
</LinearLayout>
<LinearLayout android:id="@+id/attentionList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
</LinearLayout>
<LinearLayout style="@style/Panel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="vertical">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:gravity="center_vertical" android:orientation="horizontal">
<TextView style="@style/PanelTitle" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginBottom="0dp" android:drawableStart="@drawable/ic_cal_check" android:drawablePadding="8dp" android:drawableTint="@color/primary" android:gravity="center_vertical" android:text="Upcoming Bookings"/>
<com.google.android.material.button.MaterialButton android:id="@+id/dashViewAll" style="@style/PrimaryButton" android:layout_width="wrap_content" android:layout_height="40dp" android:layout_marginStart="8dp" android:minHeight="0dp" android:paddingStart="12dp" android:paddingEnd="12dp" android:text="View All Bookings" android:textSize="12sp"/>
</LinearLayout>
<HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="horizontal">
<LinearLayout android:id="@+id/upcomingBody" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical"/>
</HorizontalScrollView>
</LinearLayout>
</LinearLayout>
</ScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
