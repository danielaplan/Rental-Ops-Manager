<?xml version="1.0" encoding="utf-8"?>
<!-- Mobile version of admin/audit.html: filters (Owner, Action, Record, Date) + append-only activity table -->
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/audSwipe" android:layout_width="match_parent" android:layout_height="match_parent">
<ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:padding="12dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="24dp">

<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
<View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
<ImageButton android:id="@+id/audBell" android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bg_icon_button" android:contentDescription="Notifications" android:src="@drawable/ic_bell" app:tint="@color/muted"/>
</LinearLayout>
<View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="14dp" android:background="@color/border"/>

<LinearLayout style="@style/Panel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:orientation="vertical">
<TextView android:id="@+id/audSyncSummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="32dp" android:gravity="center_vertical" android:text="▸  Online · 0 Pending Sync" android:textColor="@color/text" android:textSize="15sp"/>
<TextView android:id="@+id/audSyncDetail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Everything is saved. Changes made while offline will appear here until they are synced." android:textColor="@color/muted" android:textSize="12sp" android:visibility="gone"/>
</LinearLayout>

<LinearLayout style="@style/Panel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="vertical">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Owner" android:textColor="@color/text" android:textSize="15sp" android:textStyle="bold"/>
<Spinner android:id="@+id/audOwner" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="6dp" android:background="@drawable/bg_panel" android:paddingStart="8dp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Action" android:textColor="@color/text" android:textSize="15sp" android:textStyle="bold"/>
<EditText android:id="@+id/audAction" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="6dp" android:background="@drawable/bg_panel" android:hint="e.g. booking_created" android:importantForAutofill="no" android:inputType="text" android:paddingStart="14dp" android:paddingEnd="14dp" android:singleLine="true" android:textSize="15sp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Record" android:textColor="@color/text" android:textSize="15sp" android:textStyle="bold"/>
<EditText android:id="@+id/audRecord" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="6dp" android:background="@drawable/bg_panel" android:hint="e.g. booking or booking 10" android:importantForAutofill="no" android:inputType="text" android:paddingStart="14dp" android:paddingEnd="14dp" android:singleLine="true" android:textSize="15sp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Date" android:textColor="@color/text" android:textSize="15sp" android:textStyle="bold"/>
<com.google.android.material.button.MaterialButton android:id="@+id/audDate" style="@style/OutlineButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="start|center_vertical" android:text="mm/dd/yyyy" android:textColor="@color/text" app:icon="@drawable/ic_calendar" app:iconGravity="end" app:iconTint="@color/muted"/>
<com.google.android.material.button.MaterialButton android:id="@+id/audClear" style="@style/OutlineButton" android:layout_width="wrap_content" android:layout_height="40dp" android:layout_marginTop="10dp" android:minHeight="0dp" android:paddingStart="12dp" android:paddingEnd="12dp" android:text="Clear filters" android:textSize="12sp" app:icon="@drawable/ic_refresh" app:iconSize="16dp"/>
</LinearLayout>

<LinearLayout style="@style/Panel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="vertical">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
<TextView style="@style/PanelTitle" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginBottom="0dp" android:text="Append-only activity"/>
<TextView android:id="@+id/audCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_badge_outline" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:text="0 entries" android:textColor="@color/text" android:textSize="12sp" android:textStyle="bold"/>
</LinearLayout>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:layout_marginBottom="12dp" android:text="Audit entries can be reviewed but cannot be edited or deleted." android:textColor="@color/muted" android:textSize="13sp"/>
<HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="horizontal">
<LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical">
<LinearLayout android:id="@+id/audHeader" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@color/bg" android:orientation="horizontal"/>
<LinearLayout android:id="@+id/audTable" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical"/>
</LinearLayout>
</HorizontalScrollView>
<TextView android:id="@+id/audEmpty" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:padding="16dp" android:text="No audit entries match the filters." android:textColor="@color/muted" android:textSize="14sp" android:visibility="gone"/>
</LinearLayout>

</LinearLayout>
</ScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
